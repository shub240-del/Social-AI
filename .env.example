# Social AI — backend configuration.
# Copy to .env for local development. Never commit a filled-in copy.

# ---- runtime ---------------------------------------------------------
ENVIRONMENT=development          # development | test | production
LOG_LEVEL=INFO
SERVICE_NAME=socialai-api
HOST=0.0.0.0
PORT=8000

# Comma-separated. Must not contain "*" in production.
ALLOWED_ORIGINS=http://localhost:3000

# ---- database --------------------------------------------------------
# Local development (no server needed):
DATABASE_URL=sqlite+aiosqlite:///./socialai.db
#
# Supabase, runtime connections — port 6543 is the transaction pooler.
# DATABASE_URL=postgresql+asyncpg://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres
#
# Supabase, migrations — the pooler cannot run DDL reliably, so Alembic must
# use the direct connection on 5432. Leave unset to reuse DATABASE_URL.
# MIGRATION_DATABASE_URL=postgresql+asyncpg://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres
POSTGRES_POOL_SIZE=5
POSTGRES_MAX_OVERFLOW=5
DB_ECHO=false

# ---- auth ------------------------------------------------------------
# RS256 keypair, PEM. Generate with:
#   openssl genpkey -algorithm RSA -pkeyopt rsa_keygen_bits:2048 -out private.pem
#   openssl rsa -in private.pem -pubout -out public.pem
# Required in production. If unset in development an ephemeral keypair is
# generated at startup, which invalidates all tokens on every restart.
JWT_PRIVATE_KEY=
JWT_PUBLIC_KEY=
JWT_ALGORITHM=RS256
JWT_ISSUER=https://api.socialai.io
JWT_AUDIENCE=https://api.socialai.io
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_SECONDS=1209600

# Optional Auth0 federation. Setting AUTH0_DOMAIN also requires AUTH0_ISSUER.
# AUTH0_DOMAIN=
# AUTH0_AUDIENCE=
# AUTH0_ISSUER=

# ---- AI provider -----------------------------------------------------
# Required in production. Get one at https://build.nvidia.com/.
NVIDIA_API_KEY=
NVIDIA_API_BASE_URL=https://integrate.api.nvidia.com/v1
DEFAULT_LLM_MODEL=meta/llama-3.1-70b-instruct
LLM_TIMEOUT_SECONDS=60
LLM_MAX_RETRIES=2
LLM_MAX_OUTPUT_TOKENS=1024

# Serves deterministic canned completions when no API key is set, so the app
# is usable offline. MUST be false in production — the config validator
# refuses to start otherwise.
ALLOW_MOCK_LLM=true

# ---- abuse limits ----------------------------------------------------
RATE_LIMIT_ENABLED=true
RATE_LIMIT_AUTH_PER_MINUTE=10     # login / register / refresh
RATE_LIMIT_CHAT_PER_MINUTE=20
RATE_LIMIT_DEFAULT_PER_MINUTE=120
MAX_CHAT_PROMPT_CHARS=8000

# ---- transactional email ---------------------------------------------
# `console` logs the message instead of sending it, so signup and password
# reset are fully exercisable offline. Production refuses to start on
# `console` — a silently-unsent verification email is indistinguishable from
# a working system until users complain.
EMAIL_BACKEND=console
EMAIL_FROM=no-reply@socialai.io
# SMTP_HOST=
SMTP_PORT=587
SMTP_USE_TLS=true
# SMTP_USERNAME=
# SMTP_PASSWORD=

# Base URL used to build the links inside those emails. Must be https in
# production, or the links will point somewhere users cannot trust.
FRONTEND_BASE_URL=http://127.0.0.1:3000

# Turn on only once SMTP actually works: enabling it first locks out every
# existing account, because nobody has verified yet.
REQUIRE_EMAIL_VERIFICATION=false
EMAIL_VERIFY_TTL_SECONDS=86400     # 24 hours
PASSWORD_RESET_TTL_SECONDS=3600    # 1 hour

# ---- error monitoring ------------------------------------------------
# Optional. Without it a production 500 exists only as a log line nobody is
# watching. Install with: pip install -e '.[monitoring]'
# SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=0.1
RELEASE_VERSION=unknown

# ---- signing keys ----------------------------------------------------
# Required in production. Leave unset locally and a shared development
# keypair is cached at $TMPDIR/socialai-dev-jwt.pem so that every worker
# process signs with the same key.
# JWT_PRIVATE_KEY=
# JWT_PUBLIC_KEY=
