# =============================================================================
# ENVIRONMENT CONFIGURATION - SOCIALAI PLATFORM
# =============================================================================

# Application Environment
ENVIRONMENT=development
LOG_LEVEL=DEBUG

# PostgreSQL 16 OLTP Connection Configuration
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=socialai_dev
POSTGRES_USER=socialai_user
POSTGRES_PASSWORD=socialai_secret_dev_pass
DATABASE_URL=postgresql+asyncpg://socialai_user:socialai_secret_dev_pass@localhost:5432/socialai_dev

# Redis 7 Cluster / Standalone Configuration
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_URL=redis://localhost:6379/0

# ClickHouse 24 OLAP Configuration
CLICKHOUSE_HOST=localhost
CLICKHOUSE_HTTP_PORT=8123
CLICKHOUSE_NATIVE_PORT=9000
CLICKHOUSE_DB=socialai_analytics
CLICKHOUSE_USER=default
CLICKHOUSE_PASSWORD=clickhouse_secret_dev_pass

# LocalStack AWS Emulation Configuration
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=mock_access_key
AWS_SECRET_ACCESS_KEY=mock_secret_key
S3_ENDPOINT_URL=http://localhost:4566

# Auth0 Identity Provider Configuration
AUTH0_DOMAIN=socialai-dev.us.auth0.com
AUTH0_AUDIENCE=https://api.socialai.io
AUTH0_ISSUER=https://socialai-dev.us.auth0.com/

# Temporal Cloud / Local Execution Configuration
TEMPORAL_HOST=localhost:7233
TEMPORAL_NAMESPACE=default

# Pinecone Vector Store Configuration
PINECONE_API_KEY=mock_pinecone_api_key
PINECONE_ENVIRONMENT=us-east-1-aws
PINECONE_INDEX_NAME=socialai-brand-memory

# AI Model Provider Credentials
GEMINI_API_KEY=mock_gemini_api_key
OPENAI_API_KEY=mock_openai_api_key
ANTHROPIC_API_KEY=mock_anthropic_api_key
NVIDIA_API_KEY=mock_nvidia_api_key
NVIDIA_API_BASE_URL=https://integrate.api.nvidia.com/v1
DEFAULT_LLM_MODEL=meta/llama-3.1-70b-instruct
