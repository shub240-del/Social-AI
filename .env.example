# =============================================================================
# Social AI - environment configuration
# =============================================================================
# Every key below is read by packages/shared_core/config.py. Keys that the code
# does not read have been removed (redis, clickhouse, localstack, temporal,
# pinecone, gemini/openai/anthropic) - nothing in this repository imports them.
#
# Copy to .env for local development:  cp .env.example .env
# Production values are validated on boot; see .env.production.example.
# =============================================================================

# --- application -------------------------------------------------------------
ENVIRONMENT=development          # development | staging | production
LOG_LEVEL=DEBUG                  # DEBUG | INFO | WARNING | ERROR
RELEASE_VERSION=1.0.0
API_V1_PREFIX=/api/v1

# --- database ----------------------------------------------------------------
# The application uses the async driver. Leaving DATABASE_URL unset falls back
# to a local sqlite file, which is rejected when ENVIRONMENT=production.
DATABASE_URL=postgresql+asyncpg://socialai_user:socialai_secret_dev_pass@localhost:5432/socialai_dev
# Alembic needs a sync driver. If unset it is derived from DATABASE_URL by
# swapping +asyncpg for +psycopg2, so you normally do not need to set this.
MIGRATION_DATABASE_URL=postgresql+psycopg2://socialai_user:socialai_secret_dev_pass@localhost:5432/socialai_dev
POSTGRES_POOL_SIZE=5
POSTGRES_MAX_OVERFLOW=5
DB_ECHO=false

# --- authentication ----------------------------------------------------------
# RS256 keypair, PEM encoded. Newlines may be written as \n on one line.
# Generate with:
#   openssl genpkey -algorithm RSA -pkeyopt rsa_keygen_bits:2048 -out jwt.pem
#   openssl rsa -in jwt.pem -pubout -out jwt.pub
# In development both may be left empty: an ephemeral keypair is generated and
# shared between workers. Production refuses to start without them.
JWT_PRIVATE_KEY=
JWT_PUBLIC_KEY=
JWT_ISSUER=https://api.socialai.io
JWT_AUDIENCE=https://api.socialai.io
ACCESS_TOKEN_TTL_SECONDS=900         # 15 minutes
REFRESH_TOKEN_TTL_SECONDS=2592000    # 30 days
REQUIRE_EMAIL_VERIFICATION=false
EMAIL_VERIFY_TTL_SECONDS=86400       # 24 hours
PASSWORD_RESET_TTL_SECONDS=3600      # 1 hour

# --- Auth0 (optional, legacy) -------------------------------------------------
# Authentication is self hosted. These are only honoured for verifying tokens
# minted by an existing Auth0 tenant. Set all three or none; a partial
# configuration fails validation.
AUTH0_DOMAIN=
AUTH0_ISSUER=
AUTH0_AUDIENCE=

# --- CORS and links -----------------------------------------------------------
# Comma separated exact origins. "*" is rejected in production.
ALLOWED_ORIGINS=http://127.0.0.1:3000,http://localhost:3000
# Base URL used to build verification and password reset links in emails.
FRONTEND_BASE_URL=http://127.0.0.1:3000

# --- AI provider (NVIDIA NIM) --------------------------------------------------
NVIDIA_API_KEY=
NVIDIA_API_BASE_URL=https://integrate.api.nvidia.com/v1
DEFAULT_LLM_MODEL=meta/llama-3.1-70b-instruct
LLM_TIMEOUT_SECONDS=60
LLM_MAX_RETRIES=3
LLM_MAX_OUTPUT_TOKENS=1024
# Serves canned completions when no API key is set. Rejected in production so a
# deploy can never silently answer users with mock text.
ALLOW_MOCK_LLM=true

# --- email --------------------------------------------------------------------
EMAIL_BACKEND=console            # console | memory | smtp  (console/memory are dev only)
EMAIL_FROM=Social AI <no-reply@socialai.io>
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_USE_TLS=true

# --- rate limiting -------------------------------------------------------------
# In-process fixed window. With N replicas the effective limit is N x the value
# below; move to a shared store before scaling out horizontally.
RATE_LIMIT_ENABLED=true
RATE_LIMIT_PER_MINUTE=120
AUTH_RATE_LIMIT_PER_MINUTE=10

# --- observability (optional) ---------------------------------------------------
SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=0.1
