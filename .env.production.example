# =============================================================================
# Social AI - PRODUCTION environment template
# =============================================================================
# This file replaces the former `.env.production`, which was committed to a
# public repository with a live provider API key. It contains NO real values.
# Set real values in the Railway service variables UI (backend) and the Vercel
# project settings (frontend), never in a committed file.
#
# packages/shared_core/config.py refuses to start with ENVIRONMENT=production
# when any of the following is true, so an incomplete copy of this file fails
# loudly at boot rather than silently degrading:
#   - DATABASE_URL is sqlite, or missing
#   - JWT_PRIVATE_KEY / JWT_PUBLIC_KEY is missing
#   - ALLOW_MOCK_LLM is true
#   - SAKANA_API_KEY is missing or still a placeholder
#   - ALLOWED_ORIGINS is empty, "*", or contains an http:// origin
#   - EMAIL_BACKEND is console/memory, or smtp without SMTP_HOST
#   - FRONTEND_BASE_URL is not https
#   - Auth0 is only partially configured
# =============================================================================

ENVIRONMENT=production
LOG_LEVEL=INFO
RELEASE_VERSION=1.0.0

# Railway injects PORT at runtime. Do not hardcode it.
PORT=

# -----------------------------------------------------------------------------
# Database - Supabase / Neon
# -----------------------------------------------------------------------------
# Supabase exposes two endpoints:
#   transaction pooler :6543 - application runtime
#   session / direct   :5432 - required for Alembic DDL
#
# On the :6543 transaction pooler asyncpg prepared statements break, so
# prepared_statement_cache_size=0 is mandatory; without it you get intermittent
# "prepared statement _asyncpg_ already exists" errors under load.
DATABASE_URL=postgresql+asyncpg://postgres.PROJECT_REF:PASSWORD@aws-0-REGION.pooler.supabase.com:6543/postgres?prepared_statement_cache_size=0

# Alembic runs synchronously and cannot use the asyncpg driver. This must be a
# psycopg2 URL against the direct :5432 endpoint. See railway.toml preDeploy.
MIGRATION_DATABASE_URL=postgresql+psycopg2://postgres.PROJECT_REF:PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres

# The pooler enforces its own ceiling. Keep per-instance pools small and scale
# replicas instead; 20+10 per replica exhausts the pooler almost immediately.
POSTGRES_POOL_SIZE=5
POSTGRES_MAX_OVERFLOW=5
DB_ECHO=false

# -----------------------------------------------------------------------------
# Authentication - self hosted RS256
# -----------------------------------------------------------------------------
# Generate once and store as Railway secrets:
#   openssl genpkey -algorithm RSA -pkeyopt rsa_keygen_bits:2048 -out jwt.pem
#   openssl rsa -in jwt.pem -pubout -out jwt.pub
# Paste the PEM contents; literal \n escapes are accepted for single-line vars.
# Rotating these invalidates every issued access and refresh token.
JWT_PRIVATE_KEY=
JWT_PUBLIC_KEY=
JWT_ISSUER=https://api.socialai.io
JWT_AUDIENCE=https://api.socialai.io
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_SECONDS=2592000
REQUIRE_EMAIL_VERIFICATION=true
EMAIL_VERIFY_TTL_SECONDS=86400
PASSWORD_RESET_TTL_SECONDS=3600

# Optional legacy Auth0 verification. Set all three or leave all three empty.
AUTH0_DOMAIN=
AUTH0_ISSUER=
AUTH0_AUDIENCE=

# -----------------------------------------------------------------------------
# CORS and links
# -----------------------------------------------------------------------------
# Exact https origins only. Must include the Vercel domain that serves the app.
ALLOWED_ORIGINS=https://app.socialai.io,https://socialai.io
FRONTEND_BASE_URL=https://app.socialai.io

# -----------------------------------------------------------------------------
# AI provider - Sakana AI (Fugu)
# -----------------------------------------------------------------------------
# Issue a key at https://console.sakana.ai and set it in Railway variables only.
# The key must have an active subscription: without one the API authenticates
# but answers every completion with 429 usage_limit_reached.
SAKANA_API_KEY=
SAKANA_API_BASE_URL=https://api.sakana.ai/v1
DEFAULT_LLM_MODEL=fugu
# Fugu orchestrates multiple frontier models per request. Keep this well above
# a single-model provider's timeout, and above the platform's own if possible.
LLM_TIMEOUT_SECONDS=120
LLM_MAX_RETRIES=3
LLM_MAX_OUTPUT_TOKENS=1024
# Must stay false in production; the boot guard rejects true.
ALLOW_MOCK_LLM=false

# -----------------------------------------------------------------------------
# Email - real SMTP required in production
# -----------------------------------------------------------------------------
EMAIL_BACKEND=smtp
EMAIL_FROM=Social AI <no-reply@socialai.io>
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_USE_TLS=true

# -----------------------------------------------------------------------------
# Rate limiting
# -----------------------------------------------------------------------------
# In-process fixed window: the effective limit is this value multiplied by the
# replica count. Move to a shared store before scaling beyond one instance.
RATE_LIMIT_ENABLED=true
RATE_LIMIT_PER_MINUTE=120
AUTH_RATE_LIMIT_PER_MINUTE=10
# Chat is the only route billed per call by Sakana. Budget it separately from
# ordinary reads so a scripted client cannot run up the bill at the default
# 120/min while still leaving the rest of the API usable.
CHAT_RATE_LIMIT_PER_MINUTE=20

# -----------------------------------------------------------------------------
# Observability - optional
# -----------------------------------------------------------------------------
# sentry-sdk ships in the image via the "monitoring" extra. Leaving SENTRY_DSN
# empty disables it entirely.
SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=0.1

# -----------------------------------------------------------------------------
# Frontend (Vercel project settings, not this service)
# -----------------------------------------------------------------------------
# NEXT_PUBLIC_API_URL=https://api.socialai.io
#
# Intentionally absent: Redis, ClickHouse, Temporal, Pinecone, S3/LocalStack,
# OpenAI/Gemini/Anthropic. No code in this repository reads them. Add each one
# in the same commit as the code that consumes it.
# -----------------------------------------------------------------------------
