# Production Environment Configuration — Public Beta v1.0
NODE_ENV=production
ENVIRONMENT=production
LOG_LEVEL=INFO

# Server & Gateway
PORT=8000
HOST=0.0.0.0
ALLOWED_ORIGINS=https://app.socialai.io,https://socialai.io

# Auth0 Authentication
AUTH0_DOMAIN=auth.socialai.io
AUTH0_AUDIENCE=https://api.socialai.io
JWT_ALGORITHM=RS256

# PostgreSQL Database (Aurora Serverless v2)
POSTGRES_HOST=postgres.production.internal
POSTGRES_PORT=5432
POSTGRES_DB=socialai_prod
POSTGRES_USER=socialai_admin
# POSTGRES_PASSWORD — REQUIRED: inject from HashiCorp Vault / AWS SecretsManager at deploy time
POSTGRES_PASSWORD=REQUIRED_FROM_VAULT
POSTGRES_POOL_SIZE=20
POSTGRES_MAX_OVERFLOW=10

# AI Model Provider Credentials
GEMINI_API_KEY=REQUIRED_FROM_VAULT
OPENAI_API_KEY=REQUIRED_FROM_VAULT
ANTHROPIC_API_KEY=REQUIRED_FROM_VAULT
NVIDIA_API_KEY=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
NVIDIA_API_BASE_URL=https://integrate.api.nvidia.com/v1
DEFAULT_LLM_MODEL=meta/llama-3.1-70b-instruct

# Redis Cache & Cluster
REDIS_HOST=redis.production.internal
REDIS_PORT=6379
REDIS_SSL=true
# REDIS_PASSWORD — REQUIRED: inject from HashiCorp Vault at deploy time
REDIS_PASSWORD=REQUIRED_FROM_VAULT

# ClickHouse Analytics Engine
CLICKHOUSE_HOST=clickhouse.production.internal
CLICKHOUSE_PORT=8123
CLICKHOUSE_HTTP_PORT=8123
CLICKHOUSE_DB=analytics_prod
# CLICKHOUSE_PASSWORD — REQUIRED: inject from HashiCorp Vault at deploy time
CLICKHOUSE_PASSWORD=REQUIRED_FROM_VAULT

# Observability
OPENTELEMETRY_ENABLED=true
PROMETHEUS_METRICS_ENABLED=true
