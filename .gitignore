# alongside pnpm-lock.yaml resolves a different dependency tree.
package-lock.json
yarn.lock
dist/
build/
.turbo/
coverage/
*.log

# Python
__pycache__/
*.py[cod]
*$py.class
.venv/
venv/
ENV/
