.ruff_cache/
*.egg-info/
.eggs/

# Environment and Secrets
# NOTE: this block was the cause of the .env.production credential leak.
# The previous list enumerated .env.local / .env.*.local but NOT .env.production,
# so .env.production was tracked by git. Deny-all-then-allow is the only safe shape.
.env
.env.*
!.env.example
!.env.*.example
*.pem
*.key
*.p12
*.pfx
secrets.json

# IDEs & System
.vscode/
.idea/
.DS_Store
Thumbs.db

# OS / Scratch
scratch/
tmp/
